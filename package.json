{
	"name": "@frapetti-dev/ansible-vaults",
	"version": "1.0.0",
	"description": "omp plugin: ansible_vault tool to list/add/update/delete keys in Ansible Vault files without exposing values to the model",
	"author": "frapetti-dev (https://github.com/frapetti-dev)",
	"type": "module",
	"main": "src/ansible-vault.ts",
	"files": [
		"src/ansible-vault.ts",
		"src/password-store.ts",
		"src/line-input.ts",
		"src/vaults-ui.ts",
		"src/tsp-nodes.ts",
		"README.md"
	],
	"keywords": [
		"omp",
		"omp-plugin",
		"omp-extension",
		"ansible",
		"ansible-vault",
		"secrets"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frapetti-dev/ansible-vaults.git"
	},
	"homepage": "https://github.com/frapetti-dev/ansible-vaults#readme",
	"bugs": "https://github.com/frapetti-dev/ansible-vaults/issues",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"omp": {
		"extensions": [
			"./src/ansible-vault.ts"
		]
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=19.2.1",
		"@oh-my-pi/pi-tui": ">=19.2.1"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test --pass-with-no-tests"
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "19.2.1",
		"@oh-my-pi/pi-tui": "19.2.1",
		"@oh-my-pi/pi-wire": "19.2.1",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
